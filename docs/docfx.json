{
  "metadata": [
    {
      "src": [
        {
          "src": "..",
          "files": [ "src/NVMathNet/NVMathNet.csproj" ]
        }
      ],
      "dest": "reference",
      "properties": { "TargetFramework": "net10.0" },
      "outputFormat": "apiPage",
      "disableGitFeatures": false
    }
  ],
  "build": {
    "content": [
      { "files": [ "reference/**.yml", "reference/toc.yml" ] },
      { "files": [ "**/*.md", "**/toc.yml" ], "exclude": [ "_site/**", "reference/**" ] }
    ],
    "output": "_site",
    "template": [ "default", "modern" ],
    "globalMetadata": {
      "_appName": "NVMath.Net",
      "_appTitle": "NVMath.Net",
      "_appFooter": "NVMath.Net — .NET wrappers for NVIDIA CUDA math libraries. MIT License.",
      "_enableSearch": true,
      "_disableContribution": false
    },
    "sitemap": { "baseUrl": "https://zcsizmadia.github.io/NVMath.Net/" }
  }
}
