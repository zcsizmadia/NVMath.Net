<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>$(DefaultTargetFrameworks)</TargetFrameworks>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>true</IsPackable>
    <RootNamespace>NVMathNet</RootNamespace>
    <AssemblyName>NVMath.Net</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- Package metadata -->
    <PackageId>NVMath.Net</PackageId>
    <Authors>Zoltan Csizmadia</Authors>
    <Copyright>Copyright (c) Zoltan Csizmadia. All rights reserved.</Copyright>
    <Description>.NET wrapper for the NVIDIA CUDA math libraries (cuFFT, cuBLASLt, cuBLAS, cuSPARSE, cuDSS, cuTENSOR, cuSOLVER, cuRAND): GPU-accelerated FFT, matrix multiplication, sparse and dense linear algebra, tensor operations and random numbers. A C# counterpart to nvmath-python.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>cuda;nvidia;gpu;math;fft;cublas;cusparse;cutensor;cusolver;curand;cudss;linear-algebra;tensor;nvmath</PackageTags>
    <PackageProjectUrl>https://zcsizmadia.github.io/NVMath.Net/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/zcsizmadia/NVMath.Net.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <!-- Source Link and symbols -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="" />
    <None Include="../../LICENSE" Pack="true" PackagePath="" />
  </ItemGroup>
</Project>
